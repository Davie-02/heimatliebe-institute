# Settings for local development — copy to `.env` and fill in what you need.
# On Render these are set in the dashboard (Environment tab); never commit real values.

APP_ENV=development                 # development | staging | production
# DATABASE_URL=                     # empty = local SQLite file in var/. Production: Supabase "Session pooler" connection string
# SECRET_KEY=                       # production only; Render generates it automatically
# SITE_URL=https://heimatliebe.onrender.com
TZ=Africa/Blantyre

# First start only: creates this administrator if none exists yet
ADMIN_USER_ID=ADMIN-001
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@heimatliebe.mw

# Email — Brevo (free: 300 emails/day). SMTP key from Brevo → SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Heimatliebe Institute <heimatliebemw@gmail.com>"

# File storage — any S3-compatible service. Empty = local folder var/uploads (development only).
#   Supabase Storage: S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3   S3_REGION=<project region, e.g. eu-central-1>
#   Backblaze B2:     S3_ENDPOINT=https://s3.<region>.backblazeb2.com               S3_REGION=<region, e.g. us-west-004>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: "Sign in with Google" (Google Cloud Console → Credentials → OAuth client ID, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=            # e.g. heimatliebe.mw to allow only institute accounts

# Optional
WHATSAPP_NUMBER=265991383466
MAX_UPLOAD_MB=10
RUN_SCHEDULER=true
# REDIS_URL=
