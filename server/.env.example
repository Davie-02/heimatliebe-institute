# API settings for local development — copy to server/.env and fill in.
# On Render these are set in the dashboard (see render.yaml). Never commit real values.

DATABASE_URL=postgresql://postgres@localhost:5432/heimatliebe
DIRECT_URL=postgresql://postgres@localhost:5432/heimatliebe
JWT_SECRET=change-me-to-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
PORT=3001
APP_ENV=development

# First start: creates the system administrator (sign in at /admin/login).
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=Choose-A-Strong-Password-1

# Example courses, classes and students (never in production).
SEED_DEMO=true

# Email through Brevo's API (free 300/day). Without it, emails are skipped and logged.
BREVO_API_KEY=
EMAIL_FROM="Heimatliebe Institute <heimatliebemw@gmail.com>"
OFFICE_NOTIFICATION_EMAIL=

# File storage: any S3-compatible bucket (Backblaze B2, Cloudflare R2). Empty = server/uploads on disk.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional extras
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
